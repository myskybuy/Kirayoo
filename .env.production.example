# VPS settings for docker-compose.prod.yml. Copy to .env.production and fill in.
# Never commit .env.production.

# ---- Database (the Postgres container is private to Docker) -------------
# Long random password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD="change-me"

# ---- App ---------------------------------------------------------------
APP_URL="https://kirayoo.in"
# Host port Nginx proxies to (bound to 127.0.0.1 only).
KIRAYO_PORT=3010
# 1 = show the OTP on the verify page for @kirayo.test demo accounts only.
# Real users always get the OTP by email. Set 0 once the demo is over.
DEMO_OTP_ON_SCREEN=1

# ---- Email (SMTP) ------------------------------------------------------
# Needed for real users to sign up / log in (OTP by email).
#   Gmail:  smtp.gmail.com, 465, your Gmail + a 16-char App Password
#   Brevo:  smtp-relay.brevo.com, 587, your Brevo login + SMTP key
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kirayo <no-reply@kirayoo.in>"

# ---- Payments (Razorpay) -----------------------------------------------
# Empty = demo payment screen. KEY_ID and NEXT_PUBLIC_KEY_ID are the same value.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Jobs --------------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET="change-me"

# ---- Money -------------------------------------------------------------
PLATFORM_FEE_PERCENT=0
DELIVERY_FEE=99
