# ---- Database ----------------------------------------------------------
# Kirayo's own Postgres container on port 5437 (see README "Database").
DATABASE_URL="postgresql://postgres:postgres@localhost:5437/kirayo?schema=public"

# ---- App ---------------------------------------------------------------
# Kirayo runs on 3001 (3000 is used by Dobara on this machine).
APP_URL="http://localhost:3001"

# ---- Email (optional) --------------------------------------------------
# Leave SMTP_HOST empty in dev: OTPs and emails are printed in the terminal
# and the OTP is shown on the verify page. Gmail: smtp.gmail.com + app password.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kirayo <no-reply@kirayo.local>"

# ---- Payments (optional) -----------------------------------------------
# Razorpay TEST keys. Leave all three empty to use the demo payment screen.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Jobs --------------------------------------------------------------
# Protects GET /api/cron?secret=...
CRON_SECRET="change-me"

# ---- Money -------------------------------------------------------------
# Commission taken from the owner payout (percent of rent). 0 = none.
PLATFORM_FEE_PERCENT=0
# Flat delivery fee in rupees; covers drop-off AND collection.
DELIVERY_FEE=99
