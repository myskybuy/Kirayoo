# Copy to .env and fill in. Every key is read on the server only, except
# NEXT_PUBLIC_* (sent to the browser). See README → "How to go live".

# ---- Database ----------------------------------------------------------
# Kirayo's own Postgres container on port 5438 (see README "Database").
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/kirayo?schema=public"

# ---- App ---------------------------------------------------------------
# Public base URL, used in email links. Kirayo runs on 3001 in dev
# (3000 is used by Dobara on this machine). Live: https://your-domain.in
APP_URL="http://localhost:3001"

# ---- Email (SMTP) ------------------------------------------------------
# Empty SMTP_HOST in dev: OTPs and emails are printed in the terminal and the
# OTP is shown on the verify page. Live: any SMTP provider, e.g.
#   Gmail:  smtp.gmail.com, 465, your Gmail + a 16-char App Password
#   Brevo:  smtp-relay.brevo.com, 587, your Brevo login + SMTP key
#   AWS SES: email-smtp.ap-south-1.amazonaws.com, 465, SES SMTP credentials
# Port 465 = TLS from the start; any other port uses STARTTLS.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Must be an address your SMTP provider lets you send from (verified sender).
MAIL_FROM="Kirayo <no-reply@kirayo.local>"

# ---- Payments (Razorpay) -----------------------------------------------
# Leave all three empty for the demo payment screen (dev only).
# Test keys (rzp_test_...) for staging; live keys (rzp_live_...) after
# Razorpay activates your account. KEY_ID and NEXT_PUBLIC_KEY_ID are the
# same value; the secret never leaves the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Jobs --------------------------------------------------------------
# Protects GET /api/cron?secret=... (hold expiry, 48 h auto-confirm, reminders).
# Live: a long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET="change-me"

# ---- Money -------------------------------------------------------------
# Commission taken from the owner payout (percent of rent). 0 = none.
PLATFORM_FEE_PERCENT=0
# Flat delivery fee in rupees; covers drop-off AND collection.
DELIVERY_FEE=99
